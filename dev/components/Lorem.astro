---
import { getCollection, getEntry } from "astro:content";
import LazyTextFileInstance from "../../src/utils/textloader";

const { type, start, count } = Astro.props as {
  type: string;
  start?: number;
  count?: number;
};

// const coll = await getCollection('loremIpsum');
// console.log(coll);

const obj: LazyTextFileInstance | { id: string; data: {id: string, path: string}, collection: string } = await getEntry(
  "loremIpsum",
  type
);
const startIdx = start ?? 0;
const endIdx = startIdx + (count ?? 0);
// const numParagraphs = endIdx + 1 - startIdx;

const paragraphs = await (async () => {
  let result: string | undefined, instance: LazyTextFileInstance;
  if ("load" in obj) {
    instance = obj;
  } else {
    // console.log(obj);
    instance = new LazyTextFileInstance(obj.data.path);
  }
  result = await instance.load();
  if (result === undefined) throw "Failed to load text from file";

  if (endIdx === startIdx) return [await instance.getParagraph(startIdx)];
  const paragraphs: string[] = [];
  for (let i = startIdx; i < endIdx; i++)
    paragraphs.push(await instance.getParagraph(i));
  return paragraphs;
})();

