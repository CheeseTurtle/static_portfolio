---
import "../styles/global.css";

import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
// import SpeedInsights from "@vercel/speed-insights/astro";

const {
  pageTitle = "Stan Soo - Portfolio",
  description = "Portfolio showcasing recent projects",
  ogimage = {
    url: "/images/imagedefault.webp",
    alt: "Default image of Stan Soo",
  },
  storyPage = false,
} = Astro.props;

const siteUrl = new URL(Astro.url).origin;
const SEO = {
  sitename: "Stan Soo's Portfolio",
  url: siteUrl,
  locale: "en_US",
  author: "Stan Soo",
  twitter: "@batstan_soo",
};

const twitterimage = `${siteUrl}${ogimage.url}`;

console.log(Astro.slots);
---

<html
  lang="en"
  class="dark:bg-[#0E0E11] bg-mint-50/5 font-montserrat scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <!-- Favicon for different platforms -->
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" href="/android-chrome-192x192.png" sizes="192x192" />
    <link rel="icon" href="/android-chrome-512x512.png" sizes="512x512" />

    <!-- Fonts -->
    <!-- /* @import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap'); */ -->
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />

    <!-- Web manifest -->
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="description" content={description} />
    <meta name="author" content={SEO.author} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${Astro.site}${Astro.url.pathname}`} />
    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogimage.url} />
    <meta property="og:image:alt" content={ogimage.alt} />
    <meta property="og:url" content={SEO.url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SEO.sitename} />
    <meta property="og:locale" content={SEO.locale} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterimage} />
    <meta name="twitter:image:alt" content={ogimage.alt} />
    <meta name="twitter:site" content={SEO.twitter} />

    <meta name="theme-color" content="#0E0E11" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Styles -->
    <slot name="style" />
    <!-- <link rel="stylesheet" href="/src/styles/global.css" type="text/css" /> -->
    <!-- {
      storyPage && (
        <link
          rel="stylesheet"
          href={`${import.meta.env.BASE}/styles/story.css`}
          type="text/css"
        />
      )
    } -->

    <!-- GSAP DevTools
<script
src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/GSDevTools.min.js"
></script> -->
  </head>
  <body
    class:list={[
      "overflow-hidden", // 'overflow-x-hidden',
      { "story-layout": storyPage },
    ]}></body>
    <!--<SpeedInsights />-->
  <div class="background blur-circle"></div>
  <div
    style="background:linear-gradient(45deg, rgba(96, 250, 155, 0) 10.79%, rgba(96, 250, 170, 0.03) 40.92%, rgba(96, 250, 155, 0) 90.35%)"
    class="background fixed top-0 left-0 w-full h-full pointer-events-none -z-1">
  </div>

  <Header />
  <!-- Height: 15vh -->

  <!-- <div class="body-scroll-content"> -->
  <div id="root" class="body-content h-[85vh] overflow-y-auto overscroll-contain">
    <slot />
    <!-- {storyPage && <Footer />} -->
    {!storyPage && <Footer />}
  </div>
  <div id="modal-root"></div>

  <script>
    import "../scripts/menu.js";
  </script>
</html>
