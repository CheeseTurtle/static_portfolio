async function processProjectItems(imagePaths: Set<string>, prepath: string | string[], entries: ProjectEntry[]): Promise<ProjectDataWithFactory[]> {
    // console.log('Entries:', [...entries.values()])
    return await Promise.all(
        entries.map(async (entry)=>await processProjectItem(imagePaths, prepath, entry))
    )
}

async function processProjectItem(imagePaths: Set<string>, prepath: string | string[], entry: ProjectEntry): Promise<ProjectDataWithFactory> {
    // console.log('Processing entry:', entry);
    let entryPath: string = entry.filePath;
    
    const contentLoader = ((entryPath in contentRecord) || (!entryPath.startsWith('/') && ((entryPath='/'+entryPath) in contentRecord))) ? contentRecord[entryPath] : undefined;    
    
    const contentPromise = contentLoader?.();
    const contentInstance = await contentPromise;
    // const contentElem = contentInstance ? <contentInstance.Content/> : null;
    // const factory = (
    //     contentInstance ? contentInstance.Content : 
    const rp = (undefined === contentInstance) ? (entry as ProjectEntry).render() : null;

    // const contentHtml = contentElem && await renderComponentToString(contentElem, 'turtle');

    // const rp = (entry as ProjectEntry).render();
    // const rp = render(entry as ProjectEntry);


    const fullPaths: string[] = entry.data.images?.map((fn: string): string | undefined => {
        const result = getImagePath(imagePaths, prepath, fn);
        if(!result) {
            console.warn('Could not expand path:', fn);
        }
        return result;
    }).filter((x: string | undefined)=>undefined !== x);


    const rr = rp ? await rp : null;

    const Factory: AstroComponentFactory = contentInstance?.Content || rr!.Content;

    // console.log(rr);
    
    // // console.log('Pre-render body:', p.body)
    // const rr = await rp;
    // // console.log('Render result:', rp, rr);
    // const factory: AstroComponentFactory = rr.Content;

    // const contentElem = <rr.Content/>;


    const strippedBody = entry.body?.trim();
    const contentMdx = strippedBody && strippedBody.length > 0 ? strippedBody : undefined;
    // const contentElem = mdxToReactComponent(contentMdx);

    // const contentHtml = await renderComponentToString(Factory, {});
    
    // console.log(contentHtml);
    
    return {
        id: entry.id,
        category: entry.data.category,
        title: entry.data.title,
        date: entry.data.date,
        description: entry.data.description,
        summary: entry.data.summary,
        tags: entry.data.tags,
        contentMdx: contentMdx,
        images: fullPaths,
        factory: Factory,
        // contentElem: contentElem,
        // contentHtml: contentHtml
  };
} 




