const symMap: Record<symbol, string> = {};
const lbFactories: Record<string, AstroComponentFactory> = {};
const factories: Record<string, AstroComponentFactory> = {};

function parseDateValue(value: Date | string | number): [Date, string | undefined] {
    switch(typeof value) {
        case 'string':
            return parseDate(value);
        case 'number':
            return [new Date(value, 0), undefined];
        case 'object':
            return [value, undefined];
        default:
            // eslint-disable-next-line @typescript-eslint/restrict-template-expressions
            throw TypeError(`Expected Date, string, or number; got ${typeof value}: ${value}`);
    }
}

function compareDates(a: Date, b: Date): number {
    return (
        a === b ? 0 : (
            a < b ? -1 : 1
        )
    );
}


function findCaptionLoader(record: typeof captionRecord, path: string) {
    
    const id = trimID(path);
    const pattern = new RegExp(`^(?:.*/)?${id}[.][Mm][Dd][Xx]?$`);
    for(const key of Object.keys(record)) {
        // console.log(id, key);
        if(pattern.test(key)) return record[key];
    }
    return null;
}


async function getContentFromPath(kind: string, record: (typeof captionRecord), path: string) {
    // const entry = captionRecord[path] ?? captionRecord[path + '.mdx'];
    const loader = findCaptionLoader(record, path);
    if(!loader) {
        console.error(`Cannot find ${kind} MD(X) file ${path}`);
        return null;
    }
    const result = await loader();
    const key = `${kind}_${path}`;
    const sym = Symbol(key);
    const key2 = sym.toString();
    symMap[sym] = key2;
    lbFactories[key2] = result.Content;
    // return result.Content;
    return sym;
    // return <result.Content></result.Content> as Element;
}

async function getCaptionFromPath(path: string) {
    return await getContentFromPath('caption', captionRecord, path);
}

async function getFigureFromPath(path: string) {
    return await getContentFromPath('figure', figureRecord, path);
}

function expandImagePath(fn: string) {
    const result = getImagePath(imagePaths, prepath, fn);
    if(!result) {
        console.warn('Could not expand path:', fn);
        return null;
    }
    return result;
}

async function extractFnAndCaption(x: ProjectImageEntry): Promise<[string | symbol | null, string | symbol | null]> {
    if(typeof x === 'string') {
        return [x ? expandImagePath(x) : null, null];
    } else if(Array.isArray(x)) {
        return [x[0] ? expandImagePath(x[0]) : null, x[1] || null] as [string | null, string | null];
    }
    const source = (x.type === 'content' ? (
        await getFigureFromPath(x.path)
    ) : (
        expandImagePath(x.path)
    ));
    const caption = (x.captionPath ? (
        await getCaptionFromPath(x.captionPath)
    ) : x.caption);
    // console.log('Caption:', caption, x);
    return [source ?? null, caption || null];
}


// console.log('Projects:', items)
const projects: ProjectInfoWithLBSymbols[] = (await Promise.all(items.filter(x=>!x.exclude).map(async (data: ProjectDataWithFactory): Promise<ProjectInfoWithLBSymbols> => {
    const factory = data.factory;
    factories[trimID(data.id)] = factory;
    // data.factory = undefined;
    // console.log(data);
    const [date, dateStr] = parseDateValue(data.date);

    const pairPromises = data.images?.map(async (x: string | [string, string | undefined | null] | [string] | {path: string, caption?: string}): Promise<[string | symbol, string | symbol | null] | undefined> => {
        // const fn = typeof x === 'string' ? x : x.path;
        // const caption = (typeof x === 'string' ? null : x.caption || null);
        const [result, caption] = await extractFnAndCaption(x);
        if(!result) {
            if(caption) console.warn('Null or empty filepath/source given with non-null caption');
            return undefined;
        }
        
        return [result, caption];
    });

    const pairs: [string | symbol, string | symbol | null][] | undefined = pairPromises?.length ? (await Promise.all(pairPromises)).filter(x=>(undefined!==x)) : undefined;

    const sources: (string | symbol)[] = [], captions: (string | symbol | null)[] = [];
    
    pairs?.forEach(([fn,caption])=>{
        sources.push(fn);
        captions.push(caption);
    })

    // console.log('Pairs:', pairs);

    

    const lightboxData = pairs && sources.length ? {
        lightboxSources: sources.map(x=>convertSymbol(x)), // as LightboxSources,
        lightboxCaptions: captions?.map(x=>convertSymbol(x)), // as LightboxCaptions,
    } : undefined;


    return {
        id: trimID(data.id),
        category: data.category,
        description: data.description,
        summary: data.summary,
        title: data.title,
        date: date,
        dateStr: dateStr,
        audience: data.audience,
        contentElem: data.contentElem,
        contentHtml: data.contentHtml,
        contentMdx: data.contentMdx,
        images: data.images,
        lightboxData,
        tags: Object.fromEntries(
            Object.entries(data.tags as Record<TagKey, string[]>).map(([tagType, tagArr]) => [tagType, new Set<string>(tagArr)])
        ) as Record<TagKey, Set<string>>
    };
}))).sort((a,b)=>compareDates(a.date, b.date));

