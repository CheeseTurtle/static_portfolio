function parseDateValue(value: Date | string | number): [Date, string | undefined] {
    switch(typeof value) {
        case 'string':
            return parseDate(value);
        case 'number':
            return [new Date(value, 0), undefined];
        case 'object':
            return [value, undefined];
        default:
            throw TypeError(`Expected Date, string, or number; got ${typeof value}: ${value}`);
    }
}

function compareDates(a: Date, b: Date): number {
    return (
        a === b ? 0 : (
            a < b ? -1 : 1
        )
    );
}


const factories: Record<string, AstroComponentFactory> = {};
// console.log('Projects:', items)
const projects: ProjectInfo[] = items.map((data: ProjectDataWithFactory): ProjectInfo => {
    const factory = data.factory;
    factories[data.id] = factory;
    // data.factory = undefined;
    // console.log(data);
    const [date, dateStr] = parseDateValue(data.date);
    return {
        id: data.id,
        category: data.category,
        description: data.description,
        summary: data.summary,
        title: data.title,
        date: date,
        dateStr: dateStr,
        audience: data.audience,
        contentElem: data.contentElem,
        contentHtml: data.contentHtml,
        contentMdx: data.contentMdx,
        images: data.images,
        tags: Object.fromEntries(
            Object.entries(data.tags as Record<TagKey, string[]>).map(([tagType, tagArr]) => [tagType, new Set<string>(tagArr)])
        ) as Record<TagKey, Set<string>>
    };
}).sort((a,b)=>compareDates(a.date, b.date));

