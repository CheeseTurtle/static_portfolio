---
import ProjectBrowserInner from "./ProjectBrowserInner.astro";
import { getImagePath } from "../story/util/loadImages";

import { getCollection/*, render*/ } from "astro:content";

import type { ProjectEntry, ProjectFrontmatter, ProjectDataWithFactory, TagKey, ProjectImageEntry, ProjectInfoWithLBSymbols} from "./types";
import type { MDXInstance } from "astro";

import {convertSymbol} from "./lightbox";
import parseDate from "../story/util/parseDate";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
// import { createParser } from "./parseMdx";


import {markdown} from '@astropub/md';
import type {AstroMarkdownOptions} from '@astrojs/markdown-remark';

const prepath = [
    "/public/images/story/sidebar/",
    "/public/images/story/backdrop/",
    "/public/images/story/inline/",
    "/public/images/",
    "/public/images/projects/",
    "/public/images/posts/"
]

const imageRecords = import.meta.glob(
    ["/public/images/story/sidebar/*.{jpeg,jpg,png,gif,webp}",
    "/public/images/story/backdrop/*.{jpeg,jpg,png,gif,webp}",
    "/public/images/story/inline/*.{jpeg,jpg,png,gif,webp}",
    "/public/images/*.{jpeg,jpg,png,gif,webp}",
    "/public/images/projects/*.{jpeg,jpg,png,gif,webp}",
    "/public/images/posts/*.{jpeg,jpg,png,gif,webp}"], {eager: false, exhaustive: true});
const imagePaths = new Set<string>(Object.keys((imageRecords)));
const projectMetadata = await getCollection("projects");
const contentRecord = import.meta.glob<MDXInstance<ProjectFrontmatter>>(
    '/src/content/projects/*.mdx',
    {eager: false, exhaustive: true});
const captionRecord = import.meta.glob<MDXInstance<object>>(
    '/src/content/captions/*.mdx',
    {eager: false, exhaustive: true});
const figureRecord = import.meta.glob<MDXInstance<object>>(
    '/src/content/figures/*.mdx',
    {eager: false, exhaustive: true});
// console.log('contentRecord:', contentRecord);
// console.log('projectMetadata:', projectMetadata);

function trimID(id: string): string {
    const m = id.match(/^(.+)\.[Mm][Dd][Xx]?$/);
    if(m === null || m.length < 2) return id;
    return m[1] || id;
}
async function processProjectItems(imagePaths: Set<string>, prepath: string | string[], entries: ProjectEntry[]): Promise<ProjectDataWithFactory[]> {
    return await Promise.all(
        entries.map(async (entry)=>await processProjectItem(imagePaths, prepath, entry))
    )
}

async function processProjectItem(imagePaths: Set<string>, prepath: string | string[], entry: ProjectEntry): Promise<ProjectDataWithFactory> {
    let entryPath: string = entry.filePath!;
    
    const contentLoader = ((entryPath in contentRecord) || (!entryPath.startsWith('/') && ((entryPath='/'+entryPath) in contentRecord))) ? contentRecord[entryPath] : undefined;    
    
    const contentPromise = contentLoader?.();
    const contentInstance = await contentPromise;
    const rp = (undefined === contentInstance) ? entry.render() : null;
    const rr = rp ? await rp : null;

    const Factory: AstroComponentFactory = contentInstance?.Content || rr!.Content;

    const strippedBody = entry.body?.trim();
    const contentMdx = strippedBody && strippedBody.length > 0 ? strippedBody : undefined;
    return {
        id: trimID(entry.id),
        category: entry.data.category,
        title: entry.data.title,
        date: entry.data.date,
        description: entry.data.description,
        summary: entry.data.summary,
        tags: entry.data.tags,
        contentMdx: contentMdx,
        images: entry.data.images,
        factory: Factory,
        exclude: entry.data.exclude,
  };
} 




// Prepare data for ProjectGrid 

const items: ProjectDataWithFactory[] = await processProjectItems(imagePaths, prepath, projectMetadata);
const symMap: Record<symbol, string> = {};
const lbFactories: Record<string, AstroComponentFactory> = {};
const factories: Record<string, AstroComponentFactory> = {};

function parseDateValue(value: Date | string | number): [Date, string | undefined] {
    switch(typeof value) {
        case 'string':
            return parseDate(value);
        case 'number':
            return [new Date(value, 0), undefined];
        case 'object':
            return [value, undefined];
        default:
            // eslint-disable-next-line @typescript-eslint/restrict-template-expressions
            throw TypeError(`Expected Date, string, or number; got ${typeof value}: ${value}`);
    }
}

function compareDates(a: Date, b: Date): number {
    return (
        a === b ? 0 : (
            a < b ? -1 : 1
        )
    );
}


function findCaptionLoader(record: typeof captionRecord, path: string) {
    const id = trimID(path);
    const pattern = new RegExp(`^(?:.*/)?${id}[.][Mm][Dd][Xx]?$`);
    for(const key of Object.keys(record)) {
        if(pattern.test(key)) return record[key];
    }
    return null;
}


async function getContentFromPath(kind: string, record: (typeof captionRecord), path: string) {
    // const entry = captionRecord[path] ?? captionRecord[path + '.mdx'];
    const loader = findCaptionLoader(record, path);
    if(!loader) {
        console.error(`Cannot find ${kind} MD(X) file ${path}`);
        return null;
    }
    const result = await loader();
    const key = `${kind}_${path}`;
    const sym = Symbol(key);
    const key2 = sym.toString();
    symMap[sym] = key2;
    lbFactories[key2] = result.Content;
    return sym;
}

async function getCaptionFromPath(path: string) {
    return await getContentFromPath('caption', captionRecord, path);
}

async function getFigureFromPath(path: string) {
    return await getContentFromPath('figure', figureRecord, path);
}

function expandImagePath(fn: string) {
    const result = getImagePath(imagePaths, prepath, fn);
    if(!result) {
        console.warn('Could not expand path:', fn);
        return null;
    }
    return result;
}

async function extractFnAndCaption(x: ProjectImageEntry): Promise<[string | symbol | null, string | symbol | null]> {
    if(typeof x === 'string') {
        return [x ? expandImagePath(x) : null, null];
    } else if(Array.isArray(x)) {
        return [x[0] ? expandImagePath(x[0]) : null, x[1] || null] as [string | null, string | null];
    }
    const source = (x.type === 'content' ? (
        await getFigureFromPath(x.path)
    ) : (
        expandImagePath(x.path)
    ));
    const caption = (x.captionPath ?
        await getCaptionFromPath(x.captionPath) : x.caption);
    return [source ?? null, caption || null];
}

// const parse = createParser();

const options: AstroMarkdownOptions = {
    gfm: false,
    rehypePlugins: [],
    remarkPlugins: [],
    remarkRehype: {
        allowDangerousHtml: false,
        passThrough: [],
        handlers: {},
    },
    shikiConfig: {},
    smartypants: undefined,
    syntaxHighlight: false,
    // syntaxHighlight: 'prism'
}

const projects: ProjectInfoWithLBSymbols[] = (await Promise.all(items.filter(x=>!x.exclude).map(async (data: ProjectDataWithFactory): Promise<ProjectInfoWithLBSymbols> => {
    const factory = data.factory;
    factories[trimID(data.id)] = factory;
    const [date, dateStr] = parseDateValue(data.date);

    const pairPromises = data.images?.map(async (x: string | [string, string | undefined | null] | [string] | {path: string, caption?: string}): Promise<[string | symbol, string | symbol | null] | undefined> => {
        const [result, caption] = await extractFnAndCaption(x);
        if(!result) {
            if(caption) console.warn('Null or empty filepath/source given with non-null caption');
            return undefined;
        }
        return [result, caption];
    });

    const pairs: [string | symbol, string | symbol | null][] | undefined = pairPromises?.length ? (await Promise.all(pairPromises)).filter(x=>(undefined!==x)) : undefined;

    const sources: (string | symbol)[] = [], captions: (string | symbol | null)[] = [];
    
    pairs?.forEach(([fn,caption])=>{
        sources.push(fn);
        captions.push(caption);
    })


    const lightboxData = pairs && sources.length ? {
        lightboxSources: sources.map(x=>convertSymbol(x)), // as LightboxSources,
        lightboxCaptions: captions?.map(x=>convertSymbol(x)), // as LightboxCaptions,
    } : undefined;


    // const titleHTML = await markdown.inline(data.title);
    // console.log(titleHTML);

    return {
        id: trimID(data.id),
        category: data.category,
        description: await markdown.inline(data.description, options),
        summary: await markdown.inline(data.summary, options),
        title: await markdown.inline(data.title, options), // <><Markdown of={data.title} /></>,
        date: date,
        dateStr: dateStr,
        audience: data.audience,
        contentElem: data.contentElem,
        contentHtml: data.contentHtml,
        contentMdx: data.contentMdx,
        images: data.images,
        lightboxData,
        tags: Object.fromEntries(
            Object.entries(data.tags as Record<TagKey, string[]>).map(([tagType, tagArr]) => [tagType, new Set<string>(tagArr)])
        ) as Record<TagKey, Set<string>>
    };
}))).sort((a,b)=>compareDates(a.date, b.date));



---

<ProjectBrowserInner projects={projects.map(p=>({
    ...p,
    title: String(p.title),
    summary: String(p.summary),
    description: String(p.description),
}))} symMap={symMap}>
    <Fragment slot="project-titles">
        {
            projects.map(p=><article data-project-id={p.id}><Fragment set:html={p.title}></Fragment></article>)
        }
    </Fragment>
    <Fragment slot="project-descriptions">
        {
            projects.map(p=><article data-project-id={p.id}><Fragment set:html={p.description}></Fragment></article>)
        }
    </Fragment>
    <Fragment slot="project-summaries">
        {
            projects.map(p=><article data-project-id={p.id}><Fragment set:html={p.summary}></Fragment></article>)
        }
    </Fragment>
    <Fragment slot="carousel-content">
    {
        Object.entries(factories).map(([id, Factory]) =>
            <article data-project-id={id}><Factory></Factory></article>
        )
    }
    </Fragment>
    <Fragment slot="lightbox-content">
        {
            Object.entries(lbFactories).map(([id, Factory])=>
                <article data-item-id={id} class:list={['backdrop-blur-xs backdrop-grayscale']}><Factory/></article>
            )
        }
    </Fragment>
</ProjectBrowserInner>
