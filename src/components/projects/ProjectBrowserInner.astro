---

import "../../styles/projects.css";

// import ProjectGrid from "./grid/ProjectGrid";
// import ProjectDialog from "./overlay/dialog";

import ProjectBrowserReact from "./ProjectBrowserReact";
import { ProjectInfo } from "./types";


const props = Astro.props as {projects: ProjectInfo[]};

const rp = Astro.slots.has('default') && Astro.slots.render('default');
const html = rp ? await rp : undefined;

// console.log(html);
---

<ProjectBrowserReact projects={props.projects} contentString={html} client:only><slot/></ProjectBrowserReact>

