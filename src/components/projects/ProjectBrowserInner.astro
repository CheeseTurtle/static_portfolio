---

import ProjectBrowserReact from "./ProjectBrowserReact";
import type { ProjectInfoWithLBSymbols } from "./types";

import "../../styles/projects.css";

const props = Astro.props as {projects: ProjectInfoWithLBSymbols[], symMap: Record<symbol, string>};

// const rp = Astro.slots.has('default') && Astro.slots.render('default');
const rp = Astro.slots.has('carousel-content') && Astro.slots.render('carousel-content');
const html = rp ? await rp : undefined;

const lp = Astro.slots.has('lightbox-content') && Astro.slots.render('lightbox-content');
const lbHTML = lp ? await lp : undefined;

---

<ProjectBrowserReact projects={props.projects} contentString={html} lbContentString={lbHTML ?? ''} client:only="react">
    <slot name="carousel-content"/>
    <slot name="lightbox-content"/>
</ProjectBrowserReact>
