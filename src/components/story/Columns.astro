---
import {Image} from "astro:assets";
import type { AstroComponentInstance } from "astro/dist/runtime/server";
import type { ComponentSlotValue } from "astro/dist/runtime/server/render/slot";

// import {isImageMetadata} from "./util/typeCheck";
import getCreateInfo from "./util/loadImageMetadata";

type ColumnsProps = {
  image?: string;
  right?: boolean|string;
};

interface ColumnsSlots {
  image?: AstroComponentInstance; //typeof Image;
  default?: ComponentSlotValue;
}

const { image, right = false } = Astro.props as ColumnsProps;

const { default: _default_, image: imageSlot } = Astro.slots as ColumnsSlots;
const hasDefault = Astro.slots.has("default");


const createInfo = await getCreateInfo(image, imageSlot);


---

<div class="two-column-split">
  {<div class={"column image " + (right && right!=='false' ? "right" : "left")}>
    {(createInfo.imageElem ? createInfo.imageElem : <Image src={createInfo.imageMetadata} alt="(TODO)"></Image>)}
  </div>}

  {
    hasDefault && (
      <div class="column text">
        <slot />
      </div>
    )
  }

</div>

