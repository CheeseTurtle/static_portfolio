---
import "../../styles/story.css";

import StorySection from "./StorySection.astro";
// import SidebarSection from "./SidebarSection.astro";
import FloatingNav from "./FloatingNav.astro";
import ParallaxBackdrop from "./ParallaxBackdrop.astro";
// import ParallaxWindow from "./ParallaxWindow.astro";
import StoryAnimator from "./StoryAnimator";

// import { compile } from "@mdx-js/mdx";
import { unified } from "unified";
import remarkParse from "remark-parse";
import remarkMdx from "remark-mdx";
import { visit } from "unist-util-visit";

import fs from "node:fs/promises";
import path from "node:path";

import type { MdxJsxAttribute } from "mdast-util-mdx-jsx";

// import type {Node as VisitedNode} from "unist";

import type { MDXInstance } from "astro";

import StorySidebar from "./StorySidebar.astro";

import type {
  // ContentMarkerData,
  FullContentMarkerDataEntry,
  ContentMarkerDataEntry,
} from "./ContentMarkerPreact";

import { v4 as uuidv4 } from "uuid";
import Footer from "../layout/Footer.astro";
import loadSections from "./util/loadSections";

import type { StorySectionFrontmatter } from "./util/types/types.ts";

import { isMdxInstance } from "./util/typeCheck";
import type { Processor } from "unified";

const allSections = loadSections();

const allFrontmatter = allSections.map((s) => s.frontmatter);

async function getMdxSource(filePath: string) {
  //   const filePath = path.join(process.cwd(), "src/pages/story/sections", `${slug}.mdx`);
  const fileContents = await fs.readFile(filePath, "utf-8");
  return fileContents;
}

type UnifiedNode = ReturnType<ReturnType<ReturnType<Processor['use']>['use']>['parse']>;

import type { MdxJsxFlowElement } from "mdast-util-mdx";
function isMdxJsxFlowElement(node: UnifiedNode): node is MdxJsxFlowElement {
  return node.type === 'mdxJsxFlowElement';
}
async function extractContentMarkers(mdxSource: string) {
  const tree = await new Promise<UnifiedNode>((resolve,reject)=>{
    try {
      resolve(unified().use(remarkParse).use(remarkMdx).parse(mdxSource));
    } catch(e) {
      if(e instanceof Error)
        reject(e);
      reject(new Error(JSON.stringify(e, undefined, 2)));
    }
  });
  const found: ContentMarkerDataEntry[] = [];
  visit(tree, (node) => {
    if (
      isMdxJsxFlowElement(node) && // || node.type === 'mdxJsxTextElement')
      node.name === "ContentMarker"
    ) {
      // const idAttr = node.attributes.find(attr=>attr.type==='mdxJsxAttribute' && attr.name==='markerId');
      // if(idAttr === undefined) {
      //   console.log(node.attributes, node.data)
      //   throw "Content marker has no `data-marker-id` attribute"
      // }
      // const markerId = idAttr.value;
      // if(typeof markerId !== 'string')
      //   throw `Content marker has invalid \`data-marker-id\` attribute type: ${typeof markerId} (${markerId})`;

      const markerId = uuidv4();

      if (!node.children?.length) {
        let nameAttr: MdxJsxAttribute | undefined = undefined;
        // console.log("node.attributes:", node.attributes)
        for (const attr of node.attributes) {
          if (attr.type === "mdxJsxAttribute") {
            if (attr.name === "imageName" || attr.name === "contentFile") {
              if (typeof attr.value === "string") {
                found.push([
                  markerId,
                  [node, attr.value, attr.name[0] === "c"],
                ]);
                nameAttr = attr;
                break;
              } else if (attr.value && typeof attr.value === "object") {
                console.warn(
                  "Dynamic value for ContentMarker name is not supported:",
                  attr.value
                );
              } else {
                console.warn(
                  "Unsupported attribute value type for `imageName`:",
                  typeof attr.value
                );
              }
            } else {
              console.warn(
                "Skipping unknown attribute:",
                attr.name,
                attr.value
              );
            }
          } else {
            // if(attr.type === 'mdxJsxExpressionAttribute') {
            console.warn(
              "Skipping spread attributes on ContentMarker:",
              attr.value
            );
          }
        }
        if (nameAttr === undefined) {
          console.error(
            "Content marker missing `imageName`/`contentFile` attribute"
          ); // TODO: Provide more context?
        }
      }
    }
  });
  return found;
}

function getContentMarkers(
  section: MDXInstance<StorySectionFrontmatter>
): Promise<FullContentMarkerDataEntry[]> {
  const filePath = path.isAbsolute(section.file)
    ? section.file
    : path.join(process.cwd(), section.file);
  const source = getMdxSource(filePath);
  const markers = source
    .then(extractContentMarkers)
    .then((markers) =>
      markers.map(
        (pair): FullContentMarkerDataEntry => [pair[0], [section, ...pair[1]]]
      )
    );
  return markers;
}

const contentMarkerData = await (async (sections) => {
  const promises = sections.map(getContentMarkers);
  const sectionContentMarkers = await Promise.allSettled(promises);
  const results: Array<FullContentMarkerDataEntry> = [];
  for (const result of sectionContentMarkers) {
    // console.log("Result:", result)
    if (result.status === "fulfilled") {
      results.push(...result.value);
    } else {
      console.warn("Parsing of file failed because of:", result.reason);
    }
  }
  return results;
})(allSections.filter(isMdxInstance));


---

<Fragment>
  
  <!-- This container has a FIXED HEIGHT -->
  <ParallaxBackdrop specs={allFrontmatter} />
  <div class="story overflow-y-auto h-screen"> <!-- scroller -->
    <!-- (BEGIN FIXED HEIGHT CONTAINER CONTENTS) -->
    
    <div class="story-scroll-content overflow-y-visible overflow-x-hidden">
      <div class="header-space h-[15vh]"></div> <!-- header-buffer -->

      <!-- <div class="story-expand"> -->

      <div class="story-title">
        <h1>My Story</h1>
      </div>

      <!-- This part will be pinned when the content goes full-screen / immersive? -->
      <div class="story-main overflow-y-visible"> <!-- wrapper -->

        <StorySidebar specs={allFrontmatter} markerData={contentMarkerData} />

        <div id="story-sections" class="story-sections overflow-y-visible"> <!-- right -->
          {allSections.map((section) => <StorySection {...section} />)}
          <div class="story-sections-end"></div>
        </div>
      </div>

      <!-- </div> -->
      <div class="footer-buffer"></div>
      <Footer />
    </div> <!-- end of story-scroll-content -->

    <!-- FloatingNav is fixed and does not affect layout -->
    <FloatingNav sections={allSections} />

    <!-- (END FIXED HEIGHT CONTAINER CONTENTS) -->
  </div>

  <StoryAnimator
    sections={allSections}
    markers={contentMarkerData}
    client:load
  />
</Fragment>
