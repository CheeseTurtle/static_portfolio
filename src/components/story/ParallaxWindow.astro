---
const {
  sectionId,
  image,
  x,
  y,
  windowWidth = "initial",
  windowHeight,
  imageWidth = "auto",
  imageHeight,
} = Astro.props as ImageWindowArgs;

// Parse windowWidth, windowHeight, imageWidth, imageHeight?
// Set element id



---

<div class="parallax-image-wrapper" data-section-id={sectionId}>
  <img class="parallax-image" src={image} />
</div>

