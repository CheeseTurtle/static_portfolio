{
  "extends": [
    "development"
  ],
  "ignoredUrls": [
    {
      "domain": "node_modules/*",
      "hints": ["*"]
    },
    {
      "domain": "dist/*",
      "hints": ["*"]
    }
  ],
  "hints": {
    "manifest-app-name": "off",
    "axe/text-alternatives": [
      "default",
      {
        "document-title": "off"
      }
    ]
  }
}